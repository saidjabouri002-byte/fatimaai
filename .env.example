# Public URL of the site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.dz

# Booking link (Calendly, Cal.com, WhatsApp…). Empty = CTAs scroll to the on-page form.
NEXT_PUBLIC_CONSULTATION_URL=

# VSL: YouTube, Vimeo or direct .mp4 URL. Empty = designed placeholder.
NEXT_PUBLIC_VSL_VIDEO_URL=
NEXT_PUBLIC_VSL_POSTER_URL=

# WhatsApp number (international format, no "+"), offered as fallback contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-side: the consultation form POSTs a JSON payload to this webhook
# (Make, Zapier, n8n, Google Apps Script, your CRM…). Empty = form reports it is not configured.
CONSULTATION_WEBHOOK_URL=
